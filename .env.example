# Приклад змінних оточення. Скопіювати в .env і заповнити реальними значеннями.
# .env НЕ комітиться в git.

# --- База даних ---
POSTGRES_USER=store_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=store_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://store_user:change_me@db:5432/store_db

# --- Backend ---
SECRET_KEY=change_me
BACKEND_CORS_ORIGINS=http://localhost:3000

# ADMIN_COOKIE_SECURE — чи ставити прапорець Secure на кукі входу (адмінської
# й клієнтської — обидві керуються цим одним значенням). За замовчуванням
# False, бо локально сайт працює по http://localhost без HTTPS — з True
# браузер узагалі не прийме куку, і вхід ніде не спрацює.
# На проді, коли підключено HTTPS (docs/https-setup.md) — ОБОВ'ЯЗКОВО
# виставити True, інакше кука адміна піде відкритим каналом.
ADMIN_COOKIE_SECURE=False

# --- Telegram-сповіщення про нові заявки ---
# TELEGRAM_BOT_TOKEN — токен бота. Отримати: у Telegram написати @BotFather,
# команда /newbot, дати назву й юзернейм (має закінчуватись на "bot") —
# у відповідь прийде токен виду 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# TELEGRAM_CHAT_IDS — chat_id усіх, хто має отримувати сповіщення, через кому,
# БЕЗ пробілів: 123456789,987654321
# Дізнатись свій chat_id: написати боту @userinfobot будь-яке повідомлення —
# він одразу відповість твоїм Id. Так само кожен новий отримувач (менеджер
# тощо) дізнається свій id через @userinfobot і надсилає його тобі для
# додавання в цей список.
# Важливо: перед першою відправкою кожен отримувач має сам написати
# створеному боту хоч одне повідомлення — Telegram забороняє боту писати
# першим людині, яка з ним ще не заговорила.
# Додати нового отримувача в майбутньому — просто дописати його chat_id
# через кому в цей рядок, без змін коду.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# --- Нова Пошта (автопідказки міст/відділень у checkout) ---
# NOVA_POSHTA_API_KEY — ключ API 2.0. Отримати:
# my.novaposhta.ua → Налаштування → Безпека (або "API 2.0") → «Створити ключ».
# Потрібен звичайний акаунт клієнта Нової Пошти (реєстрація через SMS).
# Безкоштовно, ліміт ~100 запитів/хв. Виглядає як довгий рядок літер+цифр без пробілів.
NOVA_POSHTA_API_KEY=

# --- Frontend ---
# NEXT_PUBLIC_API_URL — адреса для запитів з браузера (клієнта)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# API_INTERNAL_URL — адреса для запитів із самого Next.js-сервера (усередині Docker-мережі,
# тому ім'я сервіса backend, а не localhost)
API_INTERNAL_URL=http://backend:8000/api
# NEXT_PUBLIC_SITE_URL — публічна адреса самого сайту (без /api), для sitemap.xml,
# robots.txt, canonical-посилань і JSON-LD. Має вказувати на nginx (порт 80), не напряму
# на frontend (порт 3000) — саме через nginx однаково резолвяться і сторінки, і /media/
# фото, як і буде на проді за одним доменом. Змінити на реальний домен після запуску.
NEXT_PUBLIC_SITE_URL=http://localhost
